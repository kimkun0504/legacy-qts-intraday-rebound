# Massive (massive.com) keys for scripts/massive.py.
# Copy this file to .env (gitignored, never committed) and paste each key after its "=" sign.
#
# Flat files (S3): the dashboard shows a separate "Access Key ID" and "Secret Access Key"
# for flat files. These are not the API key.
MASSIVE_S3_ACCESS_KEY_ID=paste-access-key-id
MASSIVE_S3_SECRET_ACCESS_KEY=paste-secret-access-key
# REST API key (reference data: active and delisted tickers; quotes for sampled trades later)
MASSIVE_API_KEY=paste-api-key
